# Backend do banco: "duckdb" (padrão, sem infraestrutura) ou "postgres"
FIFA2026_DB_BACKEND=duckdb

# Usado apenas se FIFA2026_DB_BACKEND=postgres
FIFA2026_POSTGRES_URL=postgresql://user:password@localhost:5432/fifa2026

# --- APIs de dados (extractors) ---

# FRED (macro EUA) — grátis, mesmo dia
# Obter em: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Banxico SIE (turismo México) — grátis, token imediato
# Obter em: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# INEGI (macro México — PIB, CPI, desemprego) — grátis, aprovação automática
# Obter em: https://www.inegi.org.mx/app/api/indicadores/interna/
INEGI_TOKEN=

# yfinance: não precisa de chave
# StatCan: não precisa de chave