# Backend do banco: "duckdb" (padrão, sem infraestrutura) ou "postgres"
FIFA2026_DB_BACKEND=duckdb

# Usado apenas se FIFA2026_DB_BACKEND=postgres
FIFA2026_POSTGRES_URL=postgresql://user:password@localhost:5432/fifa2026

# Chaves de API para extractors (preencher conforme integração)
FRED_API_KEY=
BCB_SGS_API_KEY=
TOURISM_ECONOMICS_API_KEY=
