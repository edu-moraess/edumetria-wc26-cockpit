# ============================================================
# Edumetria WC26 Cockpit — Variáveis de Ambiente
# ============================================================
# Copiar para .env (nunca commitar .env no GitHub)
# No Streamlit Cloud: Settings → Secrets (formato TOML abaixo)

# --- Banco de dados ---
FIFA2026_DB_BACKEND=duckdb
# Para Postgres gerenciado (Supabase/Neon):
# FIFA2026_DB_BACKEND=postgres
# FIFA2026_POSTGRES_URL=postgresql://user:password@host:5432/fifa2026

# ============================================================
# APIS DE DADOS — TODAS GRATUITAS
# ============================================================

# FRED (Federal Reserve) — macro EUA, Treasuries, Sahm Rule, etc.
# Obter GRÁTIS em: https://fredaccount.stlouisfed.org/apikeys
# Aprovação instantânea, mesmo dia
FRED_API_KEY=

# Banxico SIE (turismo México)
# Obter GRÁTIS em: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Aprovação automática, mesmo dia
BANXICO_TOKEN=

# INEGI (macro México — PIB, CPI, desemprego)
# Obter GRÁTIS em: https://www.inegi.org.mx/app/api/indicadores/interna/
# Aprovação automática, mesmo dia
INEGI_TOKEN=

# ============================================================
# APIS SEM TOKEN (já funcionam sem configuração)
# ============================================================
# yfinance       — índices, ETFs, WTI, Brent, VIX, Gold, Natural Gas
# StatCan        — turismo e macro Canadá
# Bank of Canada — taxas, câmbio, macro Canadá
# World Bank     — dados históricos (Copa anteriores, países controle DiD)

# ============================================================
# APIS FUTURAS (fase pós-MVP — deixar em branco por enquanto)
# ============================================================

# INEGI (já ativo acima)

# IMF Data API — sem token, mas adicionar quando integrado
# IMF_BASE_URL=https://dataservices.imf.org/REST/SDMX_JSON.svc

# OECD API — sem token, mas requer validação de endpoints
# OECD_BASE_URL=https://stats.oecd.org/SDMX-JSON/data

# GPR Index (Caldara & Iacoviello) — download manual
# Dataset em: https://www.matteoiacoviello.com/gpr.htm
# Após download: colocar em data/external/gpr/gpr_data.xlsx
# GPR_DATA_PATH=data/external/gpr/gpr_data.xlsx